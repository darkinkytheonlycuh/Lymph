<Window x:Class="LymphExecutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lymph Executor" Height="560" Width="820"
        Background="#0A0A0A" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#050505" Padding="16,10" BorderBrush="#222222" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LYMPH" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="  EXECUTOR" FontSize="20" FontWeight="Light" Foreground="#888888"/>
            </StackPanel>
        </Border>
        <TextBox x:Name="CodeBox" Grid.Row="1" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                 Background="#0D0D0D" Foreground="#D4D4D4" CaretBrush="#FFFFFF" BorderThickness="0"
                 Padding="12" VerticalScrollBarVisibility="Auto"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputBox" IsReadOnly="True" Background="#050505" Foreground="#00FF88" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="8" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Column="1" Margin="8">
                <Button Content="Run" Click="Run_Click" Margin="0,0,0,6" Padding="16,6"/>
                <Button Content="Clear" Click="Clear_Click" Padding="16,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
