<Window x:Class="LymphInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lymph Injector" Height="620" Width="920"
        Background="#0A0A0A" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#050505" BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LYMPH" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="  INJECTOR" FontSize="20" FontWeight="Light" Foreground="#888888"/>
                <TextBlock Text="   |   Gorilla Tag Modding Suite" FontSize="12" Foreground="#555555" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" Background="#0A0A0A" BorderThickness="0" Margin="8">
            <TabItem Header="User">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <TextBlock Text="Account Info" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" Foreground="#888888" Margin="0,4"/>
                            <TextBox x:Name="UsernameBox" Grid.Row="0" Grid.Column="1" Text="Unknown" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GT User ID:" Foreground="#888888" Margin="0,4"/>
                            <TextBox x:Name="UserIdBox" Grid.Row="1" Grid.Column="1" Text="" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Cosmetic Count:" Foreground="#888888" Margin="0,4"/>
                            <TextBox x:Name="CosmeticCountBox" Grid.Row="2" Grid.Column="1" Text="0" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Color Code:" Foreground="#888888" Margin="0,4"/>
                            <TextBox x:Name="ColorCodeBox" Grid.Row="3" Grid.Column="1" Text="#FFFFFF" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Added Friends:" Foreground="#888888" Margin="0,4"/>
                            <TextBox x:Name="FriendsBox" Grid.Row="4" Grid.Column="1" Text="0" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Process Status:" Foreground="#888888" Margin="0,4"/>
                            <TextBlock x:Name="ProcessStatus" Grid.Row="5" Grid.Column="1" Text="Gorilla Tag not detected" Foreground="#FF5555" Margin="0,4"/>
                        </Grid>
                        <Button Content="Refresh Status" Click="RefreshStatus_Click" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Injector">
                <StackPanel Margin="16">
                    <TextBlock Text="DLL Injection" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="DLL Path:" Foreground="#888888" Margin="0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DllPathBox" Grid.Column="0" Text="" Margin="0,4"/>
                        <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Margin="6,4,0,0"/>
                    </Grid>
                    <TextBlock Text="Target Process:" Foreground="#888888" Margin="0,8,0,4"/>
                    <TextBox x:Name="ProcessNameBox" Text="Gorilla Tag" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Inject" Click="Inject_Click" Margin="0,0,8,0"/>
                        <Button Content="Eject" Click="Eject_Click" Margin="0,0,8,0"/>
                        <Button Content="Inject Lymph Menu" Click="InjectLymph_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Spoofer">
                <StackPanel Margin="16">
                    <TextBlock Text="Spoofer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="Spoofed Username:" Foreground="#888888" Margin="0,4"/>
                    <TextBox x:Name="SpoofNameBox" Text="Lymph" Margin="0,4"/>
                    <TextBlock Text="Spoofed Color (hex):" Foreground="#888888" Margin="0,8,0,4"/>
                    <TextBox x:Name="SpoofColorBox" Text="#FFFFFF" Margin="0,4"/>
                    <TextBlock Text="Spoofed Platform:" Foreground="#888888" Margin="0,8,0,4"/>
                    <ComboBox x:Name="SpoofPlatformBox" Margin="0,4">
                        <ComboBoxItem Content="STEAM" IsSelected="True"/>
                        <ComboBoxItem Content="OCULUS"/>
                        <ComboBoxItem Content="QUEST"/>
                    </ComboBox>
                    <Button Content="Apply Spoof" Click="ApplySpoof_Click" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Account Gen">
                <StackPanel Margin="16">
                    <TextBlock Text="Account Generator" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="Generated Session ID:" Foreground="#888888" Margin="0,4"/>
                    <TextBox x:Name="SessionIdBox" IsReadOnly="True" Margin="0,4"/>
                    <TextBlock Text="Generated PlayFab ID:" Foreground="#888888" Margin="0,8,0,4"/>
                    <TextBox x:Name="PlayFabIdBox" IsReadOnly="True" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Generate" Click="Generate_Click" Margin="0,0,8,0"/>
                        <Button Content="Equip Mid-Game" Click="Equip_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Explorer">
                <StackPanel Margin="16">
                    <TextBlock Text="Gorilla Tag Explorer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="List Rooms" Click="ListRooms_Click" Margin="0,0,8,0"/>
                        <Button Content="List Players" Click="ListPlayers_Click" Margin="0,0,8,0"/>
                        <Button Content="List Cosmetics" Click="ListCosmetics_Click"/>
                    </StackPanel>
                    <TextBox x:Name="ExplorerOutput" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="300" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Mod Manager">
                <StackPanel Margin="16">
                    <TextBlock Text="Monke Mod Manager" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="Game Path:" Foreground="#888888" Margin="0,4"/>
                    <TextBox x:Name="GamePathBox" Text="" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Detect Game" Click="DetectGame_Click" Margin="0,0,8,0"/>
                        <Button Content="Setup Plugins Folder" Click="SetupPlugins_Click" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Install BepInEx" Click="InstallBepInEx_Click" Margin="0,0,8,0"/>
                        <Button Content="Install Utilla" Click="InstallUtilla_Click" Margin="0,0,8,0"/>
                        <Button Content="Install Lymph Menu" Click="InstallLymph_Click"/>
                    </StackPanel>
                    <TextBlock Text="Status:" Foreground="#888888" Margin="0,12,0,4"/>
                    <TextBox x:Name="ModManagerStatus" IsReadOnly="True" Height="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </TabItem>            <TabItem Header="Executor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ExecCodeBox" Grid.Row="0" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                             Background="#0D0D0D" Foreground="#D4D4D4" CaretBrush="#FFFFFF" BorderThickness="0"
                             Padding="12" VerticalScrollBarVisibility="Auto"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExecOutputBox" IsReadOnly="True" Background="#050505" Foreground="#00FF88" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="8" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Column="1" Margin="8">
                            <Button Content="Run" Click="ExecRun_Click" Margin="0,0,0,6" Padding="16,6"/>
                            <Button Content="Clear" Click="ExecClear_Click" Padding="16,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>            <TabItem Header="Settings">
                <StackPanel Margin="16">
                    <TextBlock Text="Settings" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="Theme: Dark Minimalistic Wireframe" Foreground="#888888"/>
                    <TextBlock Text="Black / Gray / White palette" Foreground="#555555" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#050505" BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="#050505" Foreground="#00FF88" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>


